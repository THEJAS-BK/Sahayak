# Sahayak backend — environment configuration
# Copy to .env and adjust. NODE_ENV=production requires SMTP_* and FCM_*.

# Server
PORT=3000
NODE_ENV=development

# Database (rootless dev instance from scripts/dev-db.sh, port 5433)
DATABASE_URL=postgres://sahayak@localhost:5433/sahayak
# Test database used by vitest global setup
DATABASE_URL_TEST=postgres://sahayak@localhost:5433/sahayak_test

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=1d       # police sessions: 8h
JWT_REFRESH_TTL=90d

# Auth — dev-only: when set (and NODE_ENV != production), every issued OTP is this fixed code
OTP_DEV_CODE=123456

# Matching
MATCH_RADIUS_M=5000
DISPATCH_BATCH_SIZE=5
DISPATCH_TIMEOUT_S=90
MAX_DISPATCH_ATTEMPTS=3

# SMTP — required only when NODE_ENV=production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
#SMTP_SECURE=true

# FCM — path to a service-account JSON, or inline JSON. Required in production.
FCM_SERVICE_ACCOUNT_JSON=

# LiveKit (voice agent) — used to mint join tokens for voice sessions
LIVEKIT_URL=wss://your-project-id.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300