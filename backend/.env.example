# Sahayak backend — environment configuration
# Copy to .env and adjust. NODE_ENV=production requires SMTP_*.

# Server
PORT=3000
NODE_ENV=development

# Database — one shared Neon Postgres, used by everyone. Get the connection
# string from the Neon dashboard (use the POOLED endpoint).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# A SEPARATE test database — a Neon test branch, with its own connection string.
# The database name stays `neondb`; what differs is the host, because each Neon
# branch has its own endpoint. That is enough to tell the two apart.
# It must never be the same database as DATABASE_URL: tests truncate every
# table, so pointing it at the shared database would erase everyone's data.
# The backend refuses to start if these two resolve to the same database.
DATABASE_URL_TEST=postgresql://USER:PASSWORD@ep-yyy-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Max pooled connections. Keep this below your Neon's per-endpoint limit.
PG_POOL_MAX=10

# Auth
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Every teammate must use the SAME JWT_SECRET: tokens are signed with it, so a
# mismatch means one machine rejecting another's sessions.
JWT_ACCESS_TTL=1d       # police sessions: 8h
JWT_REFRESH_TTL=90d

# Auth — dev-only: when set (and NODE_ENV != production), every issued OTP is this fixed code
OTP_DEV_CODE=123456

# Bootstrap — the single police/officer account created by `npm run db:seed`, used in
# dev to review senior/volunteer registration verifications. Seniors and volunteers
# are NOT seeded; they register through the app.
POLICE_BOOTSTRAP_EMAIL=police@example.com

# Matching
MATCH_RADIUS_M=5000
DISPATCH_BATCH_SIZE=5
DISPATCH_TIMEOUT_S=90
MAX_DISPATCH_ATTEMPTS=3

# Requests — when true, POST /api/requests prints the body and returns 201
# without saving, dispatching or notifying anyone. For local UI work only.
REQUESTS_DRY_RUN=false

# Dev-only escape hatch: disables the OTP rate limiter (10/hour per IP).
# Never set this in production — the config ignores it when NODE_ENV=production.
# Must be reworked (key on email + IP) before a real deployment; see
# plans/deferred-before-production.md.
RATE_LIMIT_DISABLED=

# SMTP — required only when NODE_ENV=production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
#SMTP_SECURE=true

# Push notifications are not implemented. `sendPush` in
# src/modules/notifications/push.ts logs instead of delivering, and there is no
# Firebase credential in the backend. Email is the only delivery channel.
# The fcm_token columns still exist and are still populated; they are simply
# unused until push is built.

# LiveKit (voice agent) — used to mint join tokens for voice sessions
LIVEKIT_URL=wss://your-project-id.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300