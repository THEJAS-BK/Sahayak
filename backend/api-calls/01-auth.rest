### Verify OTP (senior) -> copy access_token and refresh_token
# Replace {{otpCode}} with the actual 6-digit code you received
POST {{host}}/api/auth/otp/verify
Content-Type: application/json

{
  "email": "thejasbk998@gmail.com",
  "code": "{{otpCode}}"
}

